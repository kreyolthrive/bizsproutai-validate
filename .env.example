# BizSproutAI Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# AI Provider API Keys (Optional — falls back to heuristics if not set)
# ===========================================

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Perplexity API Key (Optional)
PERPLEXITY_API_KEY=

# ===========================================
# Provider Configuration
# ===========================================

ENABLE_AI_VALIDATION=true
DEFAULT_AI_PROVIDER=chatgpt
ENABLE_CLAUDE=true
ENABLE_CHATGPT=true
ENABLE_PERPLEXITY=false

# ===========================================
# Application Configuration
# ===========================================

NEXT_PUBLIC_DOMAIN=validate.bizsproutai.com
NEXT_PUBLIC_API_URL=https://validate.bizsproutai.com/api
NODE_ENV=development

# ===========================================
# Email Delivery — Hostinger SMTP (active sender)
# ===========================================

# Active email provider: hostinger | gmail | ionos | resend
EMAIL_PROVIDER=hostinger

# Hostinger SMTP credentials
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=info@jessicacompere.com
HOSTINGER_SMTP_PASS=
HOSTINGER_FROM_EMAIL=info@jessicacompere.com

# Lead notification recipient (owner inbox — required for lead alerts)
# Set this to the Gmail address that receives forwarded mail from Hostinger.
LEADS_TO_EMAIL=bizsproutai@gmail.com

# Optional: enable SMTP self-test endpoint at /api/email-test
# Requires Authorization: Bearer <ADMIN_TOKEN> header even when true.
EMAIL_TEST_ENABLED=false

# ===========================================
# Booking Calendar (Cal.com)
# ===========================================

NEXT_PUBLIC_CAL_LINK=bizsproutai/30-min-founder-clarity-session

# ===========================================
# Security & Sessions
# ===========================================

# Sprint session signing secret — required in production.
# If unset, sessions will not survive across Vercel lambda instances.
# Generate with: openssl rand -hex 32
SPRINT_SESSION_SECRET=

# Admin dashboard bootstrap token (required to create admin_session)
ADMIN_TOKEN=

# Signing secret for admin session cookies
ADMIN_SESSION_SECRET=

# ===========================================
# Database (Supabase)
# ===========================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# Rate Limiting (Upstash Redis — recommended for production)
# Without these, rate limiting is per-instance only (not cross-lambda).
# ===========================================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# Rate Limiting Configuration
# ===========================================

RATE_LIMIT_PER_HOUR=10
MAX_AI_CALLS_PER_IP=10
DAILY_AI_BUDGET=500

# ===========================================
# Analytics & Monitoring
# ===========================================

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===========================================
# Paid Ads Retargeting (Optional)
# ===========================================

NEXT_PUBLIC_META_PIXEL_IDS=1089915446436683,774581073628901
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ===========================================
# Build Flow (Future)
# ===========================================

ENABLE_BUILD_FLOW=false

# ===========================================
# Error Tracking (Optional)
# ===========================================

# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ===========================================
# Resend (Optional — alternative email provider)
# ===========================================

# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@validate.bizsproutai.com

# ===========================================
# Legacy / Unused — kept for reference only
# ===========================================

# IONOS_SMTP_USER=
# IONOS_SMTP_PASS=
# IONOS_FROM_EMAIL=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
