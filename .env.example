# BizSproutAI Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# AI Provider API Keys (Optional - falls back to heuristics if not set)
# ===========================================

# Anthropic Claude API Key
# Used for: failure analysis, risk reasoning, verdict narratives
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key
# Used for: messaging, positioning, content generation
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=

# Perplexity API Key (Optional)
# Used for: market research, competitor analysis
# Get your key at: https://www.perplexity.ai/
PERPLEXITY_API_KEY=

# ===========================================
# Provider Configuration
# ===========================================

# Default AI provider for unspecified tasks
# Options: claude, chatgpt, perplexity, heuristic
DEFAULT_AI_PROVIDER=heuristic

# Enable/disable specific providers
ENABLE_CLAUDE=true
ENABLE_CHATGPT=true
ENABLE_PERPLEXITY=false

# ===========================================
# Application Configuration
# ===========================================

# Production domain
NEXT_PUBLIC_DOMAIN=validate.bizsproutai.com

# API URL for validation endpoint
NEXT_PUBLIC_API_URL=https://validate.bizsproutai.com/api

# Environment
NODE_ENV=development

# ===========================================
# Email Delivery (Required for report emails)
# ===========================================

# SMTP credentials used by /api/validate email delivery
# For IONOS, these values are usually:
# IONOS_SMTP_HOST=smtp.ionos.com
# IONOS_SMTP_PORT=587
IONOS_SMTP_USER=
IONOS_SMTP_PASS=
IONOS_SMTP_HOST=smtp.ionos.com
IONOS_SMTP_PORT=587

# Sender + internal notification recipient
IONOS_FROM_EMAIL=info@bizsproutai.com
IONOS_OWNER_EMAIL=info@bizsproutai.com

# Optional SMTP self-test endpoint toggle.
# In development it is enabled by default.
# In production, set true only when intentionally testing.
EMAIL_TEST_ENABLED=false

# ===========================================
# Build Flow Configuration (Future)
# ===========================================

# Enable build flow trigger on GO verdict
ENABLE_BUILD_FLOW=false

# Build service endpoints (future integration)
# BRAND_SERVICE_URL=
# WEBSITE_SERVICE_URL=
# CONTENT_SERVICE_URL=

# ===========================================
# Rate Limiting & Security
# ===========================================

# Max validations per IP per hour (0 = unlimited)
RATE_LIMIT_PER_HOUR=10

# Enable CORS for specific origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://bizsproutai.com,https://validate.bizsproutai.com

# ===========================================
# Analytics & Monitoring (Required for Production)
# ===========================================

# PostHog Analytics (Recommended - privacy-respecting product analytics)
# Get your key at: https://posthog.com/
# Features: page views, custom events, funnel tracking, feature flags
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Analytics (auto-enabled on Vercel deployments)
# Provides: traffic, performance, geo data
# No configuration needed - works automatically

# Vercel Speed Insights (auto-enabled on Vercel deployments)
# Provides: Core Web Vitals monitoring
# No configuration needed - works automatically

# Error tracking (Optional)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
